{
  "name": "webmcp-bridge",
  "version": "0.1.0",
  "description": "Bridge between browser-native WebMCP and Model Context Protocol (MCP)",
  "type": "module",
  "bin": {
    "webmcp-bridge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
